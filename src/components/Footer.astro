---
import { Icon } from "astro-icon/components";
---

<footer class="mt-auto border-t border-neutral-900/12 dark:border-white/12 py-8">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-neutral-500">
      &copy; {new Date().getFullYear()} Inmaculada Osuna
    </p>

    <div class="flex items-center gap-4">
      <a
        href="mailto:inmamuba@gmail.com"
        aria-label="Email"
        class="text-neutral-500 hover:text-accent-600 dark:hover:text-accent-300 transition-colors"
      >
        <Icon name="logos:google-gmail" class="w-5 h-5" />
      </a>
      <a
        href="https://github.com/inma-osuna"
        target="_blank"
        aria-label="GitHub"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-accent-600 dark:hover:text-accent-300 transition-colors"
      >
        <Icon name="github" class="w-5 h-5" />
      </a>
      <a
        href="https://www.linkedin.com/in/inmaculada-osuna"
        aria-label="LinkedIn"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-accent-600 dark:hover:text-accent-300 transition-colors"
      >
        <Icon name="devicon:linkedin" class="w-5 h-5" />
      </a>
    </div>
  </div>
</footer>
