---
import { Icon } from "astro-icon/components";

const pathname = Astro.url.pathname;
const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/projects", label: "Proyectos" },
  { href: "/about", label: "Perfil" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header class="flex items-center justify-between py-6 border-b border-neutral-900/12 dark:border-white/12">
  <a href="/" class="flex items-baseline gap-2">
    <span class="font-serif text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">Inmaculada Osuna</span>
    <span class="hidden sm:inline text-[10px] font-mono uppercase tracking-[0.25em] text-accent-600 dark:text-accent-300">Data</span>
  </a>

  <div class="flex items-center gap-1">
    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            "relative px-3 py-1.5 text-sm font-medium transition-colors",
            isActive(href)
              ? "text-neutral-900 dark:text-neutral-50"
              : "text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100",
          ]}
        >
          {label}
          {isActive(href) && (
            <span class="absolute -bottom-px left-3 right-3 h-px bg-accent-500"></span>
          )}
        </a>
      ))}
    </nav>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-button"
      type="button"
      class="md:hidden p-2 text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      aria-label="Open menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <button
      id="theme-toggle-button"
      type="button"
      class="p-2 text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      aria-label="Toggle between Dark and Light mode"
      data-toggle-color-scheme
    >
      <Icon name="sun" class="w-5 h-5" />
    </button>
  </div>
</header>

<!-- Mobile menu dropdown -->
<div id="mobile-menu" class="hidden md:hidden border-b border-neutral-900/12 dark:border-white/12">
  <nav class="flex flex-col py-1">
    {navLinks.map(({ href, label }) => (
      <a
        href={href}
        class:list={[
          "px-1 py-2.5 text-sm font-medium transition-colors border-b border-neutral-900/8 dark:border-white/8 last:border-0",
          isActive(href)
            ? "text-accent-600 dark:text-accent-300"
            : "text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100",
        ]}
      >
        {label}
      </a>
    ))}
  </nav>
</div>

<script is:inline>
  function setupMobileMenu() {
    const btn = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    if (btn && menu) {
      btn.addEventListener("click", () => {
        menu.classList.toggle("hidden");
      });
    }
  }
  setupMobileMenu();
  document.addEventListener("astro:after-swap", setupMobileMenu);
</script>
