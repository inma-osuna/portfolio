---
const { title, location, startDate, endDate } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-[7rem_1fr] gap-1 sm:gap-6 py-5 border-b border-neutral-900/10 dark:border-white/10 last:border-0 group">
    <span class="font-mono text-xs text-neutral-500 dark:text-neutral-500 tabular-nums pt-1">{startDate}–{endDate}</span>
    <div class="flex flex-col gap-0.5">
        <h3 class="font-serif text-lg font-medium text-neutral-900 dark:text-neutral-100 leading-snug">{title}</h3>
        <span class="text-sm text-neutral-500 dark:text-neutral-400">{location}</span>
    </div>
</div>
