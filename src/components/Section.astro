---
export interface Props {
    title?: string;
    id?: string;
    index?: string;
}

const { title, id, index } = Astro.props;
---

<section id={id} class="flex flex-col gap-6 w-full">
    {title && (
        <div class="flex items-baseline gap-3 border-b border-neutral-900/12 dark:border-white/12 pb-3">
            {index && (
                <span class="font-mono text-xs text-accent-600 dark:text-accent-300 tabular-nums">{index}</span>
            )}
            <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-neutral-500 dark:text-neutral-400">
                {title}
            </h2>
        </div>
    )}
    <slot />
</section>
