---
export interface Props {
    title?: string;
    id?: string;
}

const { title, id } = Astro.props;
---

<section id={id} class="flex flex-col gap-6 w-full mt-2">
    {title && (
        <h2 class="text-lg sm:text-xl font-bold tracking-tight text-neutral-900 dark:text-white flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-br from-rose-400 to-orange-400 shadow-sm"></span>
            {title}
        </h2>
    )}
    <slot />
</section>