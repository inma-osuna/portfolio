---
export interface Props {
    title?: string;
    id?: string;
}

const { title, id } = Astro.props;
---

<section id={id} class="flex flex-col gap-6 w-full mt-2">
    {title && (
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-white flex items-center gap-3">
            <span class="w-3 h-3 rounded-full bg-gradient-to-br from-rose-400 to-orange-400 shadow-sm"></span>
            {title}
        </h2>
    )}
    <slot />
</section>