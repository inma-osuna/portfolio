---
import "src/styles/global.css"
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import type { Props as SeoProps } from "astro-seo";
import { SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageContainer from "@/components/PageContainer.astro";
import DarkModeScript from "@/components/DarkModeScript.astro";

export interface Props {
    seo: SeoProps;
}

const { seo } = Astro.props;
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <SEO
            titleTemplate="%s — Inmaculada Osuna"
            titleDefault="Portfolio | Inmaculada Osuna"
            description="Portfolio profesional de Inmaculada Osuna: Data Engineer, Data Scientist y Data Analyst."
            {...seo}
        />
        <DarkModeScript />
        <ClientRouter />
    </head>
    <body>
        <PageContainer>
            <Header />
            <main>
                <slot />
            </main>
            <Footer />
        </PageContainer>
    </body>
</html>