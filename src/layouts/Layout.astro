---
import "src/styles/global.css"
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import type { Props as SeoProps } from "astro-seo";
import { SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageContainer from "@/components/PageContainer.astro";
import DarkModeScript from "@/components/DarkModeScript.astro";

export interface Props {
    seo: SeoProps;
}

const { seo } = Astro.props;
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <SEO
            titleTemplate="%s — Inmaculada Osuna"
            titleDefault="Portfolio | Inmaculada Osuna"
            description="Portfolio profesional de Inmaculada Osuna: Data Engineer, Data Scientist y Data Analyst."
            {...seo}
        />
        <DarkModeScript />
        <ClientRouter />
    </head>
    <body class="relative min-h-screen overflow-x-hidden selection:bg-rose-200 dark:selection:bg-rose-900">
        <!-- Luces difuminadas de fondo (Efecto Glow Tech / Coral) -->
        <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden" aria-hidden="true">
            <!-- Luz superior derecha (Coral / Rosa) -->
            <div class="absolute -top-32 -right-32 w-[30rem] h-[30rem] bg-gradient-to-br from-rose-300/35 to-orange-200/30 dark:from-rose-600/15 dark:to-orange-600/10 rounded-full blur-3xl"></div>
            <!-- Luz central izquierda (Melocotón suave) -->
            <div class="absolute top-1/3 -left-48 w-[28rem] h-[28rem] bg-gradient-to-tr from-pink-300/30 to-rose-200/25 dark:from-pink-600/10 dark:to-rose-900/15 rounded-full blur-3xl"></div>
            <!-- Luz inferior derecha (Coral sutil) -->
            <div class="absolute -bottom-32 right-1/4 w-[26rem] h-[26rem] bg-gradient-to-t from-orange-200/25 to-rose-300/20 dark:from-orange-700/10 dark:to-rose-800/10 rounded-full blur-3xl"></div>
        </div>

        <PageContainer>
            <Header />
            <main>
                <slot />
            </main>
            <Footer />
        </PageContainer>
    </body>
</html>