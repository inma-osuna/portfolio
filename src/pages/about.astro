---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import EducationCard from "@/components/Resume/EducationCard.astro";
import SkillGroup from "@/components/Resume/SkillGroup.astro";
import Skill from "@/components/Resume/Skill.astro";
---

<Layout
    seo={{
        title: "Sobre mí",
        description: "Sobre Inmaculada Osuna — formación, habilidades y experiencia",
    }}
>
    <div class="flex flex-col gap-16 py-12">
        <!-- Introduction -->
        <section class="flex flex-col gap-4 max-w-2xl">
            <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">Sobre mí</h1>
            <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
                Graduada en Matemáticas y Máster en Técnicas Cuantitativas (UGR), con especialización finalizada en Big Data, Data Science & Inteligencia Artificial (UCM). Combino una sólida base matemática con habilidades avanzadas en ingeniería de datos para resolver problemas de negocio complejos.
            </p>
            <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
                Apasionada por el rigor analítico, la automatización y el desarrollo de sistemas inteligentes que transforman grandes volúmenes de información en soluciones reales y toma de decisiones estratégicas. Cuando no estoy programando infraestructuras en la nube o analizando datos, me encontrarás preparándome para mi próxima carrera de 10 kilómetros del 18 de octubre.
            </p>
        </section>

        <!-- Languages & Info -->
        <Section title="Idiomas & Información">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex flex-col items-center text-center">
                    <h3 class="font-bold text-neutral-900 dark:text-neutral-100 mb-1">Idiomas</h3>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Español: Nativo<br>Inglés: Nivel C1</p>
                </div>
                <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex flex-col items-center text-center">
                    <h3 class="font-bold text-neutral-900 dark:text-neutral-100 mb-1">Conducción</h3>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Permiso B y vehículo propio</p>
                </div>
                <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 flex flex-col items-center text-center">
                    <h3 class="font-bold text-neutral-900 dark:text-neutral-100 mb-1">Movilidad</h3>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Nacional e internacional</p>
                </div>
            </div>
        </Section>

        <!-- Skills -->
        <Section title="Competencias Técnicas">
            <div class="flex flex-col gap-6">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <SkillGroup name="Ingeniería & Cloud">
                        <Skill icon="devicon:apachespark" name="Hadoop / Spark" />
                        <Skill icon="devicon:azure" name="Fabric / Azure" />
                        <Skill icon="devicon:googlecloud" name="Google Cloud" />
                        <Skill icon="devicon:docker" name="Docker" />
                        <div class="flex flex-col items-center gap-2 mt-2">
                            <span class="text-xs text-neutral-600 dark:text-neutral-400 font-medium">Snowflake</span>
                        </div>
                    </SkillGroup>

                    <SkillGroup name="Bases de Datos">
                        <Skill icon="devicon:postgresql" name="PostgreSQL" />
                        <Skill icon="devicon:microsoftsqlserver" name="SQL Server" />
                        <Skill icon="devicon:mongodb" name="MongoDB" />
                    </SkillGroup>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <SkillGroup name="Data Science & IA">
                        <Skill icon="devicon:python" name="Python (Pandas, Scikit-learn)" />
                        <Skill icon="devicon:r" name="R (Tidyverse)" />
                        <Skill icon="devicon:tensorflow" name="Machine / Deep Learning" />
                        <div class="flex flex-col items-center gap-2 mt-2">
                            <span class="text-xs text-neutral-600 dark:text-neutral-400 font-medium">NLP & Series Temporales</span>
                        </div>
                        <div class="flex flex-col items-center gap-2">
                            <span class="text-xs text-neutral-600 dark:text-neutral-400 font-medium">Optimización Lineal / Entera</span>
                        </div>
                    </SkillGroup>
                    
                    <SkillGroup name="Software & BI">
                        <div class="flex flex-col items-center gap-2 mb-2">
                            <span class="text-xs text-neutral-600 dark:text-neutral-400 font-medium">Power Apps / Automate</span>
                        </div>
                        <Skill icon="devicon:latex" name="LaTeX" />
                        <div class="flex flex-col items-center gap-2 mt-2">
                            <span class="text-xs text-neutral-600 dark:text-neutral-400 font-medium">Stata / SPSS</span>
                        </div>
                        <div class="flex flex-col items-center gap-2">
                            <span class="text-xs text-neutral-600 dark:text-neutral-400 font-medium">Modelado PLS-SEM</span>
                        </div>
                    </SkillGroup>
                </div>
            </div>
        </Section>

        <!-- Experiencia Profesional (Tarjetas HTML sin fechas) -->
        <Section title="Experiencia Profesional" id="experience">
            <div class="flex flex-col gap-6">
                <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 flex flex-col gap-2">
                    <div class="flex justify-between items-center">
                        <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">Prácticas Extracurriculares</h3>
                        <span class="text-xs font-medium text-neutral-500 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded-md">NTTDATA</span>
                    </div>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Orquestación de datos y análisis en la nube utilizando Microsoft Fabric. Desarrollo de soluciones low-code y automatización de flujos de trabajo con Power Apps y Power Automate. Participación en procesos de extracción, transformación y carga (ETL) de datos.</p>
                </div>
            </div>
        </Section>

        <!-- Proyectos y Tesis (Tarjetas HTML sin fechas) -->
        <Section title="Proyectos y Tesis" id="projects">
            <div class="flex flex-col gap-6">
                <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 flex flex-col gap-2">
                    <div class="flex justify-between items-center">
                        <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">Sistema Inteligente de Dynamic Pricing (TFM)</h3>
                        <span class="text-xs font-medium text-neutral-500 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded-md">UCM, Madrid</span>
                    </div>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Sistema Inteligente de Dynamic Pricing y Optimización de Capacidad en el Transporte Interurbano mediante Deep Reinforcement Learning. Aplicado como motor de precios dinámicos para Renfe.</p>
                </div>

                <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 flex flex-col gap-2">
                    <div class="flex justify-between items-center">
                        <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">Análisis de Influencers Virtuales (TFM)</h3>
                        <span class="text-xs font-medium text-neutral-500 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded-md">UGR, Granada</span>
                    </div>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Análisis del impacto y percepción de los Influencers Virtuales. Diseño del estudio y modelado de ecuaciones estructurales (PLS-SEM) a partir de datos de encuestas para extraer insights de comportamiento y métricas de negocio.</p>
                </div>

                <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 flex flex-col gap-2">
                    <div class="flex justify-between items-center">
                        <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">Geometría de la Alhambra (TFG)</h3>
                        <span class="text-xs font-medium text-neutral-500 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded-md">UGR, Granada</span>
                    </div>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Proyecto de divulgación científica combinando rigor académico y creatividad, centrado en el modelado y análisis de la geometría de los mosaicos de la Alhambra.</p>
                </div>
            </div>
        </Section>

        <!-- Education -->
        <Section title="Educación">
            <EducationCard
                title="Máster en Ciencia de Datos, Big Data & IA"
                href="#"
                startDate="2025"
                endDate="2026"
                location="Universidad Complutense de Madrid"
            />
            <EducationCard
                title="Máster en Técnicas Cuantitativas en Gestión Empresarial"
                href="#"
                startDate="2025"
                endDate="2026"
                location="Universidad de Granada"
            />
            <EducationCard
                title="Bootcamp Data Engineering"
                href="#"
                startDate="Sep 2025"
                endDate="Dic 2025"
                location="Fundación AI Granada Research & Innovation, T-Systems y Google Cloud"
            />
            <EducationCard
                title="Grado en Matemáticas"
                href="#"
                startDate="2020"
                endDate="2025"
                location="Universidad de Granada"
            />
        </Section>
    </div>
</Layout>