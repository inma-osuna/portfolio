---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import WorkPositionCard from "@/components/Resume/WorkPositionCard.astro";
import EducationCard from "@/components/Resume/EducationCard.astro";
import SkillGroup from "@/components/Resume/SkillGroup.astro";
import Skill from "@/components/Resume/Skill.astro";
---

<Layout
    seo={{
        title: "Sobre mí",
        description: "Sobre Inmaculada Osuna — formación, habilidades y experiencia",
    }}
>
    <div class="flex flex-col gap-16 py-12">
        <!-- Introduction -->
        <section class="flex flex-col gap-4 max-w-2xl">
            <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">Sobre mí</h1>
            <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
                Soy graduada en Matemáticas y Máster en Técnicas Cuantitativas por la UGR, con especialización finalizada en Big Data, Data Science e Inteligencia Artificial por la UCM[cite: 2]. Combino una sólida base matemática con habilidades avanzadas en ingeniería de datos para resolver problemas de negocio complejos[cite: 2]. 
            </p>
            <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
                Me apasiona el rigor analítico, la automatización y el desarrollo de sistemas inteligentes que transforman grandes volúmenes de información en decisiones estratégicas[cite: 2]. Cuando no estoy programando infraestructuras en la nube o analizando datos, me encontrarás preparándome para mi próxima carrera de 10 kilómetros del 18 de octubre.
            </p>
        </section>

        <!-- Skills -->
        <Section title="Habilidades">
            <div class="flex flex-col gap-6">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <SkillGroup name="Lenguajes">
                        <Skill icon="devicon:python" name="Python" />
                        <Skill icon="devicon:r" name="R" />
                        <Skill icon="devicon:cplusplus" name="C++" />
                        <Skill icon="devicon:latex" name="LaTeX" />
                    </SkillGroup>

                    <SkillGroup name="Bases de Datos">
                        <Skill icon="devicon:postgresql" name="SQL / PostgreSQL" />
                        <Skill icon="devicon:mongodb" name="MongoDB" />
                    </SkillGroup>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <SkillGroup name="Ingeniería & Cloud">
                        <Skill icon="devicon:apachespark" name="PySpark / Hadoop" />
                        <Skill icon="devicon:googlecloud" name="Google Cloud" />
                        <Skill icon="devicon:azure" name="Azure" />
                        <Skill icon="devicon:docker" name="Docker" />
                    </SkillGroup>
                    
                    <SkillGroup name="Ciencia de Datos & IA">
                        <Skill icon="devicon:tensorflow" name="Machine Learning" />
                        <Skill icon="devicon:pytorch" name="Deep Learning" />
                        <div class="flex flex-col items-center gap-2">
                            <span class="text-xs text-neutral-600 dark:text-neutral-400 font-medium">PLS-SEM</span>
                        </div>
                        <div class="flex flex-col items-center gap-2">
                            <span class="text-xs text-neutral-600 dark:text-neutral-400 font-medium">NLP</span>
                        </div>
                    </SkillGroup>
                </div>
            </div>
        </Section>

        <!-- Experience & Projects -->
        <Section title="Experiencia & Proyectos" id="experience">
            <div class="flex flex-col gap-8">
                <WorkPositionCard
                    title="Data Intern (Prácticas Extracurriculares)"
                    href="#"
                    startDate="Ene 2025"
                    endDate="May 2026"
                    location="NTTDATA (100% Remoto)"
                    description="Orquestación de datos y análisis en la nube utilizando Microsoft Fabric[cite: 2]. Desarrollo de soluciones low-code y automatización de flujos con Power Apps y Power Automate[cite: 2]. Participación en procesos ETL de datos[cite: 2]. Puesto ejecutado completamente en remoto por falta de espacio físico en la oficina."
                >
                    <Icon name="devicon:azure" class="w-7 h-7" />
                    <Icon name="devicon:microsoftsqlserver" class="w-7 h-7" />
                </WorkPositionCard>

                <WorkPositionCard
                    title="Sistema Inteligente de Dynamic Pricing (TFM)"
                    href="#"
                    startDate="2026"
                    endDate="2026"
                    location="UCM, Madrid"
                    description="Sistema de Dynamic Pricing y Optimización de Capacidad en el Transporte Interurbano mediante Deep Reinforcement Learning[cite: 2]. Aplicado como motor de precios dinámicos para Renfe utilizando PySpark y Streamlit."
                >
                    <Icon name="devicon:python" class="w-7 h-7" />
                    <Icon name="devicon:apachespark" class="w-7 h-7" />
                </WorkPositionCard>

                <WorkPositionCard
                    title="Análisis de Influencers Virtuales (TFM)"
                    href="#"
                    startDate="2026"
                    endDate="2026"
                    location="UGR, Granada"
                    description="Análisis del impacto y percepción de los Influencers Virtuales. Diseño del estudio y modelado de ecuaciones estructurales (PLS-SEM) a partir de datos de encuestas para extraer insights de comportamiento y métricas de negocio[cite: 2]."
                >
                    <Icon name="devicon:r" class="w-7 h-7" />
                </WorkPositionCard>
                
                <WorkPositionCard
                    title="Geometría de la Alhambra (TFG)"
                    href="#"
                    startDate="2025"
                    endDate="2025"
                    location="UGR, Granada"
                    description="Proyecto de divulgación científica combinando rigor académico y creatividad, centrado en el modelado y análisis de la geometría de los mosaicos de la Alhambra[cite: 2]. Análisis de los 17 grupos cristalográficos plasmado en 19 vídeos educativos publicados en TikTok."
                >
                    <Icon name="devicon:latex" class="w-7 h-7" />
                </WorkPositionCard>
            </div>
        </Section>

        <!-- Education -->
        <Section title="Educación">
            <EducationCard
                title="Máster en Ciencia de Datos, Big Data & IA"
                href="#"
                startDate="Sep 2025"
                endDate="Sep 2026"
                location="Universidad Complutense de Madrid"
            />
            <EducationCard
                title="Máster en Técnicas Cuantitativas en Gestión Empresarial"
                href="#"
                startDate="Sep 2025"
                endDate="Jul 2026"
                location="Universidad de Granada"
            />
            <EducationCard
                title="Bootcamp Data Engineering"
                href="#"
                startDate="2025"
                endDate="2026"
                location="Fundación AI Granada, T-Systems y Google Cloud[cite: 2]"
            />
            <EducationCard
                title="Grado en Matemáticas"
                href="#"
                startDate="Sep 2020"
                endDate="Dic 2025"
                location="Universidad de Granada"
            />
        </Section>
    </div>
</Layout>