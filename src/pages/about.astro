---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import EducationCard from "@/components/Resume/EducationCard.astro";

const skillGroups = [
    {
        label: "Ingeniería & Cloud",
        items: ["Hadoop / Spark", "Microsoft Fabric", "Azure", "Google Cloud", "Docker", "Snowflake"],
    },
    {
        label: "Bases de Datos",
        items: ["PostgreSQL", "SQL Server", "MongoDB"],
    },
    {
        label: "Data Science & IA",
        items: ["Python (Pandas, Sklearn)", "R (Tidyverse)", "Machine / Deep Learning", "NLP", "Series Temporales"],
    },
    {
        label: "Software, BI & Modelado",
        items: ["Power Apps / Automate", "LaTeX", "Stata / SPSS", "Modelado PLS-SEM"],
    },
];

const facts = [
    { k: "Idiomas", v: "Español (nativo) · Inglés C1" },
    { k: "Conducción", v: "Permiso B · Vehículo propio" },
    { k: "Movilidad", v: "Nacional e internacional" },
];

const education = [
    {
        title: "Máster en Ciencia de Datos, Big Data & IA",
        location: "Universidad Complutense de Madrid",
        startDate: "2025",
        endDate: "2026",
    },
    {
        title: "Máster en Técnicas Cuantitativas en Gestión Empresarial",
        location: "Universidad de Granada",
        startDate: "2025",
        endDate: "2026",
    },
    {
        title: "Bootcamp Data Engineering",
        location: "Fundación AI Granada, T-Systems y Google Cloud",
        startDate: "Sep 2025",
        endDate: "Dic 2025",
    },
    {
        title: "Grado en Matemáticas",
        location: "Universidad de Granada",
        startDate: "2020",
        endDate: "2025",
    },
];
---

<Layout
    seo={{
        title: "Perfil",
        description: "Sobre Inmaculada Osuna — formación, habilidades y experiencia",
    }}
>
    <div class="flex flex-col gap-20 py-14 md:py-20">
        <!-- Intro -->
        <header class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-8 md:items-end">
            <div class="flex flex-col gap-5 max-w-2xl">
                <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-accent-600 dark:text-accent-300">Perfil</span>
                <h1 class="font-serif text-5xl md:text-6xl font-medium tracking-tight leading-[0.95] text-neutral-900 dark:text-neutral-50 text-balance">
                    Rigor cuantitativo,<br />mentalidad de ingeniería.
                </h1>
                <p class="text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed text-pretty">
                    Data Engineer, Data Scientist y Data Analyst. Especializada en Big Data, Data Science
                    e Inteligencia Artificial (UCM), con Máster en Técnicas Cuantitativas (UGR). Combino una
                    sólida base matemática con habilidades avanzadas en ingeniería de datos para transformar
                    grandes volúmenes de información en decisiones estratégicas.
                </p>
            </div>
        </header>

        <!-- Quick facts -->
        <dl class="grid grid-cols-1 sm:grid-cols-3 border-y border-neutral-900/12 dark:border-white/12 divide-y sm:divide-y-0 sm:divide-x divide-neutral-900/12 dark:divide-white/12">
            {facts.map((f) => (
                <div class="flex flex-col gap-1 py-5 sm:px-6 first:sm:pl-0">
                    <dt class="font-mono text-[11px] uppercase tracking-[0.18em] text-neutral-500">{f.k}</dt>
                    <dd class="text-neutral-800 dark:text-neutral-200">{f.v}</dd>
                </div>
            ))}
        </dl>

        <!-- Skills -->
        <Section title="Competencias técnicas" index="/ 01">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
                {skillGroups.map((g) => (
                    <div class="flex flex-col gap-3">
                        <h3 class="font-serif text-lg text-neutral-900 dark:text-neutral-100">{g.label}</h3>
                        <ul class="flex flex-wrap gap-2">
                            {g.items.map((s) => (
                                <li class="font-mono text-xs uppercase tracking-[0.08em] text-neutral-600 dark:text-neutral-300 border border-neutral-900/15 dark:border-white/15 px-2.5 py-1">
                                    {s}
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </Section>

        <!-- Experience -->
        <Section title="Experiencia profesional" index="/ 02" id="experience">
            <div class="grid grid-cols-1 sm:grid-cols-[7rem_1fr] gap-1 sm:gap-6 py-2">
                <span class="font-mono text-xs text-neutral-500 tabular-nums pt-1">NTT DATA</span>
                <div class="flex flex-col gap-2 max-w-2xl">
                    <h3 class="font-serif text-xl text-neutral-900 dark:text-neutral-100">Prácticas Extracurriculares</h3>
                    <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
                        Orquestación de datos y análisis en la nube con Microsoft Fabric. Desarrollo de
                        soluciones low-code y automatización de flujos con Power Apps y Power Automate.
                        Participación en procesos de extracción, transformación y carga (ETL).
                    </p>
                </div>
            </div>
        </Section>

        <!-- Education -->
        <Section title="Educación" index="/ 03">
            <div class="flex flex-col">
                {education.map((e) => (
                    <EducationCard
                        title={e.title}
                        location={e.location}
                        startDate={e.startDate}
                        endDate={e.endDate}
                    />
                ))}
            </div>
        </Section>
    </div>
</Layout>
