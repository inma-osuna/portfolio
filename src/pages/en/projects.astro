---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
---

<Layout
    seo={{
        title: "Projects — Inmaculada Osuna",
        description: "Master's and Bachelor's theses, data engineering projects, and scientific outreach.",
    }}
>
    <div class="flex flex-col gap-12 py-12 max-w-4xl mx-auto antialiased">
        <div>
            <a href="/en/" class="text-sm font-semibold text-rose-500 hover:text-rose-600 transition-colors inline-flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Back to Home
            </a>
        </div>

        <header class="flex flex-col gap-3">
            <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-white">
                Projects & Theses
            </h1>
            <p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl">
                A collection of academic research, Master's final projects (TFMs), Bachelor's thesis (TFG), and applied data science solutions.
            </p>
        </header>

        <div class="grid grid-cols-1 gap-6">
            <a href="/en/projects/dynamic-pricing" class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 hover:border-rose-300 dark:hover:border-rose-700 transition-all duration-300 hover:shadow-xl hover:shadow-rose-500/10 hover:-translate-y-1 flex flex-col gap-3 group cursor-pointer">
                <div class="flex justify-between items-center">
                    <h3 class="font-bold text-neutral-900 dark:text-neutral-100 text-xl group-hover:text-rose-500 transition-colors">Intelligent Dynamic Pricing</h3>
                    <span class="px-3 py-1 text-xs font-semibold text-neutral-600 bg-neutral-100 border border-neutral-200 rounded-full dark:bg-neutral-800 dark:text-neutral-300 dark:border-neutral-700">Master's Thesis (TFM) — UCM</span>
                </div>
                <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                    Capacity optimization engine in interurban transport using Deep Reinforcement Learning models (PySpark and Streamlit).
                </p>
            </a>

            <a href="/en/projects/influencers" class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 hover:border-orange-300 dark:hover:border-orange-700 transition-all duration-300 hover:shadow-xl hover:shadow-orange-500/10 hover:-translate-y-1 flex flex-col gap-3 group cursor-pointer">
                <div class="flex justify-between items-center">
                    <h3 class="font-bold text-neutral-900 dark:text-neutral-100 text-xl group-hover:text-orange-500 transition-colors">Virtual Influencers Analysis</h3>
                    <span class="px-3 py-1 text-xs font-semibold text-neutral-600 bg-neutral-100 border border-neutral-200 rounded-full dark:bg-neutral-800 dark:text-neutral-300 dark:border-neutral-700">Master's Thesis (TFM) — UGR</span>
                </div>
                <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                    Quantitative analysis of virtual influencers' impact and consumer perception through Structural Equation Modeling (PLS-SEM) using SmartPLS and typeset in LaTeX.
                </p>
            </a>

            <a href="/en/projects/alhambra" class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 hover:border-rose-300 dark:hover:border-rose-700 transition-all duration-300 hover:shadow-xl hover:shadow-rose-500/10 hover:-translate-y-1 flex flex-col gap-3 group cursor-pointer">
                <div class="flex justify-between items-center">
                    <h3 class="font-bold text-neutral-900 dark:text-neutral-100 text-xl group-hover:text-rose-500 transition-colors">Geometry of the Alhambra</h3>
                    <span class="px-3 py-1 text-xs font-semibold text-neutral-600 bg-neutral-100 border border-neutral-200 rounded-full dark:bg-neutral-800 dark:text-neutral-300 dark:border-neutral-700">Bachelor's Thesis (TFG) — UGR</span>
                </div>
                <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                    Mathematical modeling of the 17 crystallographic groups in the Alhambra mosaics, paired with a registered scientific outreach video series.
                </p>
            </a>
        </div>
    </div>
</Layout>