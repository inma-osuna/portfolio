---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
---

<Layout
    seo={{
        title: "Portfolio | Inmaculada Osuna",
        description: "Portfolio de Inmaculada Osuna: Data Engineer, Data Scientist y Data Analyst.",
    }}
>
    <div class="flex flex-col gap-16 py-12 antialiased">
        <!-- Hero Section (Estilo Premium Silicon Valley) -->
        <section class="flex flex-col items-center text-center gap-6 mt-4">
            
            <!-- Status Pill con luz palpitante -->
            <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-sm mb-2">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
                </span>
                <span class="text-xs font-medium text-neutral-600 dark:text-neutral-300 tracking-wide">
                    Desarrollando modelos desde Granada
                </span>
            </div>

            <!-- Etiquetas de Roles -->
            <div class="flex flex-wrap justify-center gap-2">
                <span class="px-3 py-1 text-xs font-bold tracking-widest text-rose-600 bg-rose-50/50 border border-rose-200/60 rounded-full dark:bg-rose-900/10 dark:text-rose-400 dark:border-rose-800/40">DATA ENGINEER</span>
                <span class="px-3 py-1 text-xs font-bold tracking-widest text-orange-600 bg-orange-50/50 border border-orange-200/60 rounded-full dark:bg-orange-900/10 dark:text-orange-400 dark:border-orange-800/40">DATA SCIENTIST</span>
                <span class="px-3 py-1 text-xs font-bold tracking-widest text-rose-600 bg-rose-50/50 border border-rose-200/60 rounded-full dark:bg-rose-900/10 dark:text-rose-400 dark:border-rose-800/40">DATA ANALYST</span>
            </div>

            <!-- Título con Degradado -->
            <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-neutral-900 dark:text-white mt-2">
                Hola, soy <br class="sm:hidden" />
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-rose-500 to-orange-400">Inmaculada Osuna</span>
            </h1>
            
            <p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl mt-1">
                Especializada en Big Data, algoritmos de Machine Learning y arquitecturas en la nube. Transformando volúmenes complejos de información en decisiones estratégicas.
            </p>
            
            <!-- Botones y Redes Sociales -->
            <div class="flex flex-wrap justify-center items-center gap-4 mt-6">
                <a
                    href="/projects"
                    class="inline-flex items-center px-6 py-2.5 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-sm font-semibold hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-all shadow-lg hover:shadow-rose-500/20 hover:-translate-y-0.5"
                >
                    Ver Proyectos
                </a>
                <a
                    href="mailto:inmamuba@gmail.com"
                    class="inline-flex items-center px-6 py-2.5 rounded-full border border-neutral-200 dark:border-neutral-800 text-sm font-semibold text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-900 transition-all hover:-translate-y-0.5"
                >
                    Contactar
                </a>
                <div class="flex items-center gap-2 pl-2">
                    <a href="https://github.com" target="_blank" class="p-2 text-neutral-500 hover:text-rose-500 transition-colors" aria-label="GitHub">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
                    </a>
                    <a href="https://linkedin.com" target="_blank" class="p-2 text-neutral-500 hover:text-rose-500 transition-colors" aria-label="LinkedIn">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" /></svg>
                    </a>
                </div>
            </div>
        </section>

        <!-- Resumen de Habilidades Clave -->
        <Section title="Competencias Destacadas">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 text-center">
                <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white/50 dark:bg-neutral-900/50 backdrop-blur-sm shadow-sm hover:shadow-lg hover:shadow-rose-500/5 hover:-translate-y-1 transition-all duration-300">
                    <h3 class="font-bold text-neutral-900 dark:text-neutral-100 mb-2">Lenguajes & Datos</h3>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Python, R, SQL, PySpark y C++</p>
                </div>
                <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white/50 dark:bg-neutral-900/50 backdrop-blur-sm shadow-sm hover:shadow-lg hover:shadow-orange-500/5 hover:-translate-y-1 transition-all duration-300">
                    <h3 class="font-bold text-neutral-900 dark:text-neutral-100 mb-2">Cloud & DevOps</h3>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Microsoft Fabric, Snowflake, Docker y Cloud</p>
                </div>
                <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white/50 dark:bg-neutral-900/50 backdrop-blur-sm shadow-sm hover:shadow-lg hover:shadow-rose-500/5 hover:-translate-y-1 transition-all duration-300">
                    <h3 class="font-bold text-neutral-900 dark:text-neutral-100 mb-2">Modelado & IA</h3>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Machine Learning, NLP, PLS-SEM y Deep RL</p>
                </div>
            </div>
        </Section>

        <!-- Proyectos y Tesis Destacados -->
        <Section title="Proyectos y Tesis">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 hover:border-rose-300 dark:hover:border-rose-700 transition-all duration-300 hover:shadow-xl hover:shadow-rose-500/10 hover:-translate-y-1 flex flex-col justify-between gap-4 group">
                    <div>
                        <h3 class="font-bold text-neutral-900 dark:text-neutral-100 text-lg mb-2 group-hover:text-rose-500 transition-colors">Sistema de Dynamic Pricing</h3>
                        <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">Optimización de capacidad en el transporte interurbano con Deep Reinforcement Learning (TFM UCM).</p>
                    </div>
                    <span class="text-xs font-semibold text-neutral-500 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800 w-fit px-2.5 py-1 rounded-md">PySpark / Streamlit</span>
                </div>
                
                <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 hover:border-orange-300 dark:hover:border-orange-700 transition-all duration-300 hover:shadow-xl hover:shadow-orange-500/10 hover:-translate-y-1 flex flex-col justify-between gap-4 group">
                    <div>
                        <h3 class="font-bold text-neutral-900 dark:text-neutral-100 text-lg mb-2 group-hover:text-orange-500 transition-colors">Análisis de Influencers</h3>
                        <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">Diseño y modelado de ecuaciones estructurales para extraer métricas de negocio (TFM UGR).</p>
                    </div>
                    <span class="text-xs font-semibold text-neutral-500 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800 w-fit px-2.5 py-1 rounded-md">R / PLS-SEM</span>
                </div>

                <div class="p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 hover:border-rose-300 dark:hover:border-rose-700 transition-all duration-300 hover:shadow-xl hover:shadow-rose-500/10 hover:-translate-y-1 flex flex-col justify-between gap-4 group">
                    <div>
                        <h3 class="font-bold text-neutral-900 dark:text-neutral-100 text-lg mb-2 group-hover:text-rose-500 transition-colors">Geometría de la Alhambra</h3>
                        <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">Modelado matemático de los 17 grupos cristalográficos con vídeos educativos (TFG UGR).</p>
                    </div>
                    <span class="text-xs font-semibold text-neutral-500 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800 w-fit px-2.5 py-1 rounded-md">Matemáticas / LaTeX</span>
                </div>
            </div>
            <div class="mt-4">
                <a href="/projects" class="text-sm font-medium text-rose-500 dark:text-rose-400 hover:underline">Ver todos los proyectos &rarr;</a>
            </div>
        </Section>
    </div>
</Layout>