---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";

const roles = ["Data Engineer", "Data Scientist", "Data Analyst"];

const competencies = [
    {
        k: "01",
        title: "Big Data & Cloud",
        body: "Ecosistema Hadoop/Spark, orquestación en Microsoft Fabric, ETL/ELT, Snowflake, Docker, Google Cloud y Azure.",
    },
    {
        k: "02",
        title: "Ciencia de Datos & IA",
        body: "Machine y Deep Learning, redes neuronales, NLP, series temporales y estadística multivariante.",
    },
    {
        k: "03",
        title: "Cuantitativa & BI",
        body: "Modelización econométrica, optimización lineal/entera, dashboards y soluciones low-code.",
    },
];

const featured = [
    {
        n: "01",
        title: "Sistema de Dynamic Pricing",
        meta: "TFM · UCM Madrid",
        body: "Optimización de capacidad en el transporte interurbano con Deep Reinforcement Learning.",
        stack: "PySpark · Streamlit",
    },
    {
        n: "02",
        title: "Análisis de Influencers Virtuales",
        meta: "TFM · UGR Granada",
        body: "Modelado de ecuaciones estructurales (PLS-SEM) para extraer métricas de negocio.",
        stack: "R · Tidyverse",
    },
    {
        n: "03",
        title: "Geometría de la Alhambra",
        meta: "TFG · UGR Granada",
        body: "Modelado matemático de los 17 grupos cristalográficos con divulgación en vídeo.",
        stack: "Matemáticas · LaTeX",
    },
];
---

<Layout
    seo={{
        title: "Portfolio | Inmaculada Osuna",
        description: "Portfolio de Inmaculada Osuna: Data Engineer, Data Scientist y Data Analyst.",
    }}
>
    <div class="flex flex-col gap-24 py-14 md:py-20">
        <!-- Hero -->
        <section class="relative">
            <div class="grid-ground text-neutral-900 dark:text-white absolute inset-0 -z-10 opacity-50 [mask-image:radial-gradient(ellipse_at_top_left,black,transparent_75%)]"></div>

            <div class="flex flex-col gap-8 max-w-3xl">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] uppercase tracking-[0.22em] text-neutral-500 dark:text-neutral-400">
                    {roles.map((r, i) => (
                        <>
                            {i > 0 && <span class="text-accent-500">/</span>}
                            <span>{r}</span>
                        </>
                    ))}
                </div>

                <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl font-medium tracking-tight leading-[0.95] text-neutral-900 dark:text-neutral-50 text-balance">
                    Convierto datos<br />complejos en
                    <span class="italic bg-gradient-to-r from-accent-600 to-accent-300 bg-clip-text text-transparent">decisiones</span>.
                </h1>

                <p class="text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl text-pretty">
                    Graduada en Matemáticas y Máster en Técnicas Cuantitativas (UGR), especializándome en
                    Big Data, Data Science e Inteligencia Artificial (UCM). Combino rigor matemático con
                    el tratamiento de grandes volúmenes de datos para resolver problemas de negocio reales.
                </p>

                <div class="flex flex-wrap items-center gap-3 pt-1">
                    <a
                        href="/projects"
                        class="inline-flex items-center gap-2 rounded-full px-6 py-2.5 bg-neutral-900 dark:bg-neutral-50 text-neutral-50 dark:text-neutral-900 text-sm font-medium hover:bg-accent-600 dark:hover:bg-accent-300 transition-colors"
                    >
                        Ver proyectos
                        <span aria-hidden="true">&rarr;</span>
                    </a>
                    <a
                        href="mailto:inmamuba@gmail.com"
                        class="inline-flex items-center rounded-full px-6 py-2.5 border border-neutral-900/20 dark:border-white/20 text-sm font-medium text-neutral-800 dark:text-neutral-200 hover:border-accent-500 hover:text-accent-600 dark:hover:text-accent-300 transition-colors"
                    >
                        Contactar
                    </a>
                </div>
            </div>
        </section>

        <!-- Competencies -->
        <Section title="Competencias" index="/ 01">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {competencies.map((c) => (
                    <div class="group rounded-2xl border border-neutral-900/10 dark:border-white/10 bg-neutral-50/60 dark:bg-neutral-900/40 p-6 flex flex-col gap-3 transition-colors hover:border-accent-500/50 hover:bg-accent-50/50 dark:hover:bg-neutral-900">
                        <span class="font-mono text-xs text-accent-600 dark:text-accent-300">{c.k}</span>
                        <h3 class="font-serif text-xl text-neutral-900 dark:text-neutral-100">{c.title}</h3>
                        <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">{c.body}</p>
                    </div>
                ))}
            </div>
        </Section>

        <!-- Featured projects -->
        <Section title="Proyectos destacados" index="/ 02">
            <ul class="flex flex-col">
                {featured.map((p) => (
                    <li>
                        <a
                            href="/projects"
                            class="group grid grid-cols-1 sm:grid-cols-[3rem_1fr_auto] gap-2 sm:gap-6 items-baseline py-6 border-b border-neutral-900/10 dark:border-white/10 transition-colors hover:bg-neutral-900/5 dark:hover:bg-white/5 -mx-3 px-3"
                        >
                            <span class="font-mono text-xs text-neutral-400 tabular-nums">{p.n}</span>
                            <div class="flex flex-col gap-1">
                                <h3 class="font-serif text-xl md:text-2xl text-neutral-900 dark:text-neutral-100 group-hover:text-accent-600 dark:group-hover:text-accent-300 transition-colors">
                                    {p.title}
                                </h3>
                                <p class="text-sm text-neutral-600 dark:text-neutral-400 max-w-xl leading-relaxed">{p.body}</p>
                                <span class="font-mono text-[11px] uppercase tracking-[0.15em] text-neutral-500 mt-1">{p.stack}</span>
                            </div>
                            <span class="hidden sm:block font-mono text-[11px] uppercase tracking-[0.15em] text-neutral-500 whitespace-nowrap">{p.meta}</span>
                        </a>
                    </li>
                ))}
            </ul>
            <a href="/projects" class="w-fit font-mono text-xs uppercase tracking-[0.15em] text-accent-600 dark:text-accent-300 hover:underline underline-offset-4">
                Todos los proyectos &rarr;
            </a>
        </Section>
    </div>
</Layout>
