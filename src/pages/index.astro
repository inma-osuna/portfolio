---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import { formatDate } from "@/utils";

const posts: CollectionEntry<"blog">[] = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  )
  .slice(0, 3);
---

<Layout
    seo={{
        title: "Portfolio",
        description: "Portfolio de Inmaculada Osuna: proyectos, educación y experiencia en datos.",
    }}
>
    <div class="flex flex-col gap-20 py-12 antialiased">
        <!-- Hero Section -->
        <section class="flex flex-col items-center text-center gap-6">
            <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100">
                Hola, soy Inmaculada Osuna Muñoz
            </h1>
            <p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl">
                Data Engineer & Data Scientist. Especializada en Big Data, algoritmos de Machine Learning y arquitecturas en la nube. Transformando volúmenes complejos de información en decisiones estratégicas.
            </p>
            <div class="flex flex-wrap justify-center gap-3">
                <a
                    href="/projects"
                    class="inline-flex items-center px-5 py-2.5 rounded-lg bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors"
                >
                    Ver Proyectos
                </a>
                <a
                    href="mailto:inmamuba@gmail.com"
                    class="inline-flex items-center px-5 py-2.5 rounded-lg border border-neutral-300 dark:border-neutral-700 text-sm font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
                >
                    Contactar
                </a>
            </div>
        </section>

        <!-- Work Experience Highlights -->
        <Section title="Experiencia Destacada">
            <div class="flex flex-col gap-6">
                <div class="flex flex-col gap-1 border-l-2 border-primary-500 pl-4">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
                        <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">Data Intern</h3>
                        <span class="text-sm text-neutral-500">Ene 2025 — May 2026</span>
                    </div>
                    <span class="text-sm text-primary-600 dark:text-primary-400">NTTDATA (Remoto)</span>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400">Orquestación de datos y procesos ETL en la nube utilizando Microsoft Fabric.</p>
                </div>
                
            
            </div>
            <a href="/about#experience" class="text-sm font-medium text-primary-600 dark:text-primary-400 hover:underline">Ver toda la experiencia &rarr;</a>
        </Section>

        
    </div>
</Layout>