---
import Layout from "@/layouts/Layout.astro";

const projects = [
    {
        n: "01",
        title: "Motor de Dynamic Pricing",
        org: "TFM — Universidad Complutense de Madrid",
        tag: "Deep RL",
        body: "Desarrollo de un sistema inteligente de revenue management y optimización de capacidad en el transporte interurbano mediante modelos de Deep Reinforcement Learning. La solución técnica fue implementada con PySpark y cuenta con una interfaz de visualización interactiva construida en Streamlit.",
        stack: ["PySpark", "Streamlit", "Python"],
        link: null,
    },
    {
        n: "02",
        title: "Análisis de Influencers Virtuales",
        org: "TFM — Universidad de Granada",
        tag: "Data Science",
        body: "Análisis exhaustivo del impacto y la percepción de los Influencers Virtuales. El proyecto abarcó desde el diseño del estudio de mercado hasta el modelado de ecuaciones estructurales (PLS-SEM) basado en datos de encuestas, con el objetivo de extraer insights de comportamiento de consumo y métricas clave de negocio.",
        stack: ["R", "Tidyverse", "PLS-SEM"],
        link: null,
    },
    {
        n: "03",
        title: "Geometría de la Alhambra",
        org: "TFG — Universidad de Granada",
        tag: "Matemáticas",
        body: "Proyecto de investigación y divulgación científica que combina rigor académico y creatividad. Centrado en el modelado matemático de los 17 grupos cristalográficos presentes en los mosaicos de la Alhambra, complementado con la creación y registro de una serie de vídeos educativos.",
        stack: ["LaTeX", "Álgebra", "Divulgación"],
        link: {
            href: "https://www.tiktok.com/@inmaosm?is_from_webapp=1&sender_device=pc",
            label: "Ver en TikTok",
        },
    },
];
---

<Layout
    seo={{
        title: "Proyectos",
        description: "Portfolio de proyectos de Inmaculada Osuna",
    }}
>
    <div class="flex flex-col gap-16 py-14 md:py-20">
        <!-- Header -->
        <header class="flex flex-col gap-5 max-w-2xl">
            <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-accent-600 dark:text-accent-300">Índice de trabajo</span>
            <h1 class="font-serif text-5xl md:text-6xl font-medium tracking-tight leading-[0.95] text-neutral-900 dark:text-neutral-50 text-balance">
                Proyectos
            </h1>
            <p class="text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed text-pretty">
                Investigación, tesis y desarrollos aplicados en Machine Learning, optimización de datos
                y modelado matemático.
            </p>
        </header>

        <!-- Project ledger -->
        <div class="flex flex-col border-t border-neutral-900/12 dark:border-white/12">
            {projects.map((p) => (
                <article class="grid grid-cols-1 md:grid-cols-[4rem_1fr] gap-4 md:gap-8 py-10 border-b border-neutral-900/12 dark:border-white/12">
                    <div class="flex md:flex-col items-center md:items-start gap-3 md:gap-4">
                        <span class="font-mono text-sm text-accent-600 dark:text-accent-300 tabular-nums">{p.n}</span>
                        <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-neutral-500 border border-neutral-900/15 dark:border-white/15 px-2 py-0.5">
                            {p.tag}
                        </span>
                    </div>

                    <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-1">
                            <h2 class="font-serif text-2xl md:text-3xl font-medium text-neutral-900 dark:text-neutral-50 leading-snug">
                                {p.title}
                            </h2>
                            <p class="text-sm text-neutral-500 dark:text-neutral-400">{p.org}</p>
                        </div>

                        <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl text-pretty">
                            {p.body}
                        </p>

                        <div class="flex flex-wrap items-center justify-between gap-4 pt-1">
                            <ul class="flex flex-wrap gap-x-4 gap-y-1">
                                {p.stack.map((s) => (
                                    <li class="font-mono text-[11px] uppercase tracking-[0.12em] text-neutral-500 dark:text-neutral-400">
                                        {s}
                                    </li>
                                ))}
                            </ul>

                            {p.link && (
                                <a
                                    href={p.link.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 text-sm font-medium text-neutral-800 dark:text-neutral-200 border-b border-accent-500 pb-0.5 hover:text-accent-600 dark:hover:text-accent-300 transition-colors"
                                >
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                                    </svg>
                                    {p.link.label}
                                </a>
                            )}
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </div>
</Layout>
