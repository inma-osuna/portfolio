---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/Resume/ProjectCard.astro";
---

<Layout
    seo={{
        title: "Proyectos",
        description: "Colección de mis proyectos de datos e investigación",
    }}
>
    <div class="flex flex-col gap-8 py-12">
        <div class="flex flex-col gap-2">
            <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">Proyectos</h1>
            <p class="text-neutral-600 dark:text-neutral-400">Una colección de investigaciones, modelos y arquitecturas de datos.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <ProjectCard
                title="Dynamic Pricing Engine"
                href="#"
                description="Sistema Inteligente de Dynamic Pricing y Optimización de Capacidad en el Transporte Interurbano mediante Deep Reinforcement Learning."
                tags={["Python", "PySpark", "Streamlit"]}
            />
           <ProjectCard
                title="Grupos Cristalográficos Alhambra"
                href="https://www.tiktok.com/@inmaosm?is_from_webapp=1&sender_device=pc"
                description="Proyecto de divulgación científica centrado en el modelado y análisis matemático de los 17 grupos cristalográficos. (19 vídeos publicados en TikTok)."
                tags={["Matemáticas", "TikTok", "Divulgación"]}
            />
            <ProjectCard
                title="Influencers Virtuales"
                href="#"
                description="Análisis del impacto y percepción mediante diseño de estudio y modelado de ecuaciones estructurales (PLS-SEM)."
                tags={["R", "PLS-SEM", "Análisis de Datos"]}
            />
            <ProjectCard
                title="inma-osuna.com"
                href="https://github.com/tu-usuario/portfolio"
                description="Mi portafolio personal construido de forma minimalista para presentar mis proyectos y trayectoria."
                tags={["Astro", "TypeScript", "Tailwind"]}
            />
        </div>
    </div>
</Layout>